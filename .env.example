# ================================================================
# Telegram Stock Count Bot Configuration
# ================================================================

# 1. Telegram Bot Token from @BotFather (REQUIRED)
# Open Telegram -> Search @BotFather -> /newbot -> Paste token below:
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# 2. Google Apps Script Webhook URL (OPTIONAL for Real-time Google Sheet Auto-fill)
# Follow instructions in google_apps_script.js to get your Webhook URL:
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# 3. Database Path (Default: ./inventory.db)
DATABASE_PATH="inventory.db"

# 4. Photos Directory (Default: ./photos)
PHOTOS_DIR="photos"

# 5. Timezone (Default: Asia/Bangkok)
TIMEZONE="Asia/Bangkok"

# 6. Admin Telegram User IDs (Optional, comma-separated)
# e.g. ADMIN_USER_IDS="12345678,87654321"
ADMIN_USER_IDS=""
